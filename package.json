{
  "name": "revivex-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:a": "npm run start --workspace apps/direction-a",
    "start:b": "npm run start --workspace apps/direction-b",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npx tsx db/tests/rls.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.11",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  }
}
